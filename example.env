# KITH Application Configuration
# Copy this to '.env' and fill in your values.

# Flask secret key for session encryption
SECRET_KEY=generate-a-very-long-random-string-here

# Database Configuration
# Use DATABASE_URL for Postgres/MySQL, or leave blank to use SQLite by default.
# For Docker/Postgres: postgresql://username:password@db:5432/kith_db
DATABASE_URL=
# Path to local SQLite database (optional, defaults to data.db)
DATABASE_PATH=data.db

# Admin User Seeding (Optional)
# Set SEED_ADMIN to 'true' to create an initial admin user on first run.
# Requires ADMIN_PASSWORD to be set.
SEED_ADMIN=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-immediately-after-seeding
